<!DOCTYPE html>
<html>
<head>
  <title>Your Chats</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container py-5">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2>Your Chats</h2>
      <p class="text-muted mb-0">Welcome, <%= currentUser.username %></p>
    </div>

    <div>
      <a href="/rooms/new" class="btn btn-primary me-2">New Group</a>
      <a href="/logout" class="btn btn-outline-secondary">Logout</a>
    </div>
  </div>

  <!-- Card -->
  <div class="card shadow-sm rounded-4">
    <div class="card-body">

      <!-- Table header -->
      <div class="row fw-bold border-bottom pb-2 mb-3 text-muted">
        <div class="col-4">Group</div>
        <div class="col-4">Last Msg</div>
        <div class="col-4 text-end"># Unread</div>
      </div>

      <!-- Rooms -->
      <% rooms.forEach(room => { %>
        <a href="/rooms/<%= room.room_id %>" class="text-decoration-none text-dark">
          <div class="row py-3 border-bottom align-items-center">
            
            <div class="col-4 fw-semibold">
              <%= room.name %>
            </div>

            <div class="col-4 text-muted">
              <%= room.displayLastMessageTime %>
            </div>

            <div class="col-4 text-end">
              <% if (room.unread_count > 0) { %>
                <span class="badge bg-primary"><%= room.unread_count %></span>
              <% } %>
            </div>

          </div>
        </a>
      <% }) %>

      <div class="mt-3 text-muted">
        # groups: <%= groupCount %>
      </div>
    </div>
  </div>
</div>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Room <%= roomId %></title>

  <link 
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" 
    rel="stylesheet"
  >
</head>

<body class="bg-light">

<div class="container mt-4">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Room <%= roomId %></h1>

    <div>
      <a href="/rooms" class="btn btn-outline-secondary me-2">Back</a>
      <a href="/rooms/<%= roomId %>/invite" class="btn btn-primary">Invite</a>
    </div>
  </div>

  <div class="chat-container bg-white border rounded p-3 mb-4" style="max-height: 500px; overflow-y: auto;">
    <h2 class="h5 mb-3">Messages</h2>

    <% if (messages.length === 0) { %>
      <div class="alert alert-light text-center">
        No messages yet.
      </div>
    <% } %>

    <% let unreadLineShown = false; %>

    <% messages.forEach(msg => { %>

      <% if (!unreadLineShown && msg.message_id > (lastReadMessageId || 0)) { %>
        <div class="text-center my-3">
          <span class="badge bg-danger">Unread</span>
        </div>
        <% unreadLineShown = true; %>
      <% } %>

      <div class="mb-3 <%= msg.isMine ? 'text-end' : 'text-start' %>">

        <div class="small text-muted mb-1">
          <% if (msg.isMine) { %>
            <strong>You</strong> · <%= msg.displayTime %>
          <% } else { %>
            <strong><%= msg.username %></strong> · <%= msg.displayTime %>
          <% } %>
        </div>

        <div class="d-inline-block px-3 py-2 rounded 
          <%= msg.isMine ? 'bg-primary text-white' : 'bg-light' %>">
          <%= msg.text %>
        </div>
        <div class="mt-1">
          <% if (msg.reactions && msg.reactions.length > 0) { %>
            <% msg.reactions.forEach(r => { %>
              <form action="/messages/<%= msg.message_id %>/react" method="POST" class="d-inline">
                <input type="hidden" name="emoji_id" value="<%= r.emoji_id %>">
                <input type="hidden" name="roomId" value="<%= roomId %>">

                <button type="submit" class="btn btn-sm btn-light">
                  <%= r.name %> <%= r.count %>
                </button>
              </form>
            <% }) %>
          <% } %>
        </div>

        <div class="mt-1">
          <button
            type="button"
            class="btn btn-sm btn-outline-primary emoji-toggle-btn"
            data-message-id="<%= msg.message_id %>"
          >
            +
          </button>
        </div>
        <div id="emoji-box-<%= msg.message_id %>" class="mt-2" style="display:none;">
          <% emojis.forEach(emoji => { %>
            <form action="/messages/<%= msg.message_id %>/react" method="POST" class="d-inline">
              <input type="hidden" name="emoji_id" value="<%= emoji.emoji_id %>">
              <input type="hidden" name="roomId" value="<%= roomId %>">

              <button type="submit" class="btn btn-sm btn-outline-secondary mb-1">
                <%= emoji.name %>
              </button>
            </form>
          <% }) %>
        </div>

      </div>

    <% }) %>
  </div>
  <div class="card p-3">
    <h3 class="h6">Send a new message</h3>

    <form action="/rooms/<%= roomId %>/messages" method="POST">
      <textarea 
        name="text" 
        rows="3" 
        class="form-control mb-2"
        placeholder="Type your message..."
        required
      ></textarea>

      <button type="submit" class="btn btn-success">
        Send
      </button>
    </form>
  </div>

</div>
<script>
  document.querySelectorAll('.emoji-toggle-btn').forEach(button => {
    button.addEventListener('click', () => {
      const messageId = button.dataset.messageId;
      const box = document.getElementById(`emoji-box-${messageId}`);
      if (!box) return;

      box.style.display = box.style.display === "none" ? "block" : "none";
    });
  });
</script>

</body>
</html>
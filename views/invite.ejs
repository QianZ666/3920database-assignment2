<h1>Invite People to Room <%= roomId %></h1>

<a href="/rooms/<%= roomId %>">Back to room</a>

<hr>

<h2>Current Members</h2>

<ul>
  <% members.forEach(member => { %>
    <li><%= member.username %> (<%= member.email %>)</li>
  <% }) %>
</ul>

<hr>

<h2>Available Users</h2>

<% if (users.length === 0) { %>
  <p>No more users available to invite.</p>
<% } else { %>
  <ul>
    <% users.forEach(user => { %>
      <li>
        <%= user.username %> (<%= user.email %>)
        <form action="/rooms/<%= roomId %>/invite" method="POST" style="display:inline;">
          <input type="hidden" name="userId" value="<%= user.user_id %>">
          <button type="submit">Invite</button>
        </form>
      </li>
    <% }) %>
  </ul>
<% } %>